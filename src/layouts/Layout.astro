---
import StarfieldCanvas from '../components/animations/StarfieldCanvas';
import CosmicAudio from '../components/animations/CosmicAudio';
import CosmicSearchModal from '../components/search/CosmicSearchModal';
import { getSiteConfig } from '../lib/cosmic-service';
import '../styles/global.css';

const siteConfig = getSiteConfig();

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  canonical?: string;
}

const {
  title = siteConfig.metaTitle || "The Cosmic Inquiry | Interactive Astronomy & Cosmic Discovery Platform",
  description = siteConfig.metaDescription || "A cinematic digital observatory and scientific discovery platform exploring the solar system, black holes, the Big Bang, spacetime, and cosmic mysteries. Created by Albin Thomas.",
  image = siteConfig.ogImage || "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1200&q=80",
  type = "website",
  canonical = Astro.url.href
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : "https://the-cosmic-inquiry.netlify.app";
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Albin Thomas" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="The Cosmic Inquiry" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#02040a" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "The Cosmic Inquiry",
      "url": siteUrl,
      "description": description,
      "creator": {
        "@type": "Person",
        "name": "Albin Thomas"
      },
      "educationalUse": "Astronomy, Astrophysics and Cosmology Discovery"
    })} />
  </head>

  <body class="bg-[#02040a] text-slate-100 min-h-screen flex flex-col font-body selection:bg-violet-600 selection:text-white">
    <!-- Starfield Interactive Canvas -->
    <StarfieldCanvas client:load />

    <!-- Primary Navigation Header -->
    <header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-cosmic-950/70 border-b border-violet-500/15 transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <!-- Logo / Brand Identity -->
        <a href="/" class="flex items-center gap-3.5 group">
          <div class="relative w-10 h-10 flex items-center justify-center">
            <!-- Orbital Rings SVG -->
            <svg class="w-10 h-10 text-violet-400 group-hover:rotate-45 transition-transform duration-700" viewBox="0 0 100 100" fill="none">
              <ellipse cx="50" cy="50" rx="42" ry="16" transform="rotate(-30 50 50)" stroke="currentColor" stroke-width="2" class="opacity-40" />
              <ellipse cx="50" cy="50" rx="42" ry="16" transform="rotate(30 50 50)" stroke="#06b6d4" stroke-width="2" class="opacity-40" />
              <circle cx="50" cy="50" r="10" fill="url(#cosmic-grad)" class="shadow-[0_0_15px_rgba(139,92,246,0.8)]" />
              <defs>
                <linearGradient id="cosmic-grad" x1="0" y1="0" x2="100" y2="100" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#8b5cf6" />
                  <stop offset="0.6" stop-color="#06b6d4" />
                  <stop offset="1" stop-color="#ffffff" />
                </linearGradient>
              </defs>
            </svg>
          </div>

          <div>
            <span class="site-name-text text-base sm:text-lg font-bold tracking-[0.2em] font-heading text-white group-hover:text-violet-300 transition-colors block">
              {siteConfig.siteName}
            </span>
            <span class="creator-subtitle-text text-[9px] font-mono tracking-[0.25em] text-cyan-400 uppercase block">
              {siteConfig.creatorSubtitle}
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center gap-7 text-xs font-mono font-medium text-slate-300">
          <a href="/#solar-system" class="hover:text-cyan-300 transition-colors">SOLAR SYSTEM</a>
          <a href="/#discover" class="hover:text-violet-300 transition-colors">DISCOVER</a>
          <a href="/chronicle" class="hover:text-pink-300 transition-colors">CHRONICLE</a>
          <a href="/timeline" class="hover:text-stellar-amber transition-colors">TIMELINE</a>
          <a href="/glossary" class="hover:text-emerald-300 transition-colors">GLOSSARY</a>
          <a href="/admin" class="hover:text-purple-300 transition-colors text-violet-400 font-semibold flex items-center gap-1">
            <span>ADMIN</span>
          </a>
        </nav>

        <!-- Right Action Controls -->
        <div class="flex items-center gap-2 sm:gap-3">
          <CosmicAudio client:load />
          <CosmicSearchModal client:load />

          <!-- Mobile Menu Trigger -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="lg:hidden p-2.5 rounded-xl bg-cosmic-900 border border-violet-500/25 text-slate-300 hover:text-white hover:border-violet-400 text-xs font-mono transition-all flex items-center gap-1.5"
            aria-label="Toggle Navigation Menu"
            aria-expanded="false"
          >
            <svg id="hamburger-icon" class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="close-icon" class="w-4 h-4 text-cyan-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span class="sr-only">Menu</span>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div
        id="mobile-menu-drawer"
        class="hidden lg:hidden border-b border-violet-500/20 bg-cosmic-950/95 backdrop-blur-2xl px-6 py-6 transition-all animate-fade-in"
      >
        <nav class="flex flex-col space-y-4 text-sm font-mono">
          <a
            href="/#solar-system"
            class="mobile-nav-link flex items-center justify-between py-2.5 border-b border-violet-500/10 text-slate-200 hover:text-cyan-300 transition-colors"
          >
            <span>🪐 3D SOLAR SYSTEM</span>
            <span class="text-xs text-cyan-400">&rarr;</span>
          </a>
          <a
            href="/#discover"
            class="mobile-nav-link flex items-center justify-between py-2.5 border-b border-violet-500/10 text-slate-200 hover:text-violet-300 transition-colors"
          >
            <span>🌌 DISCOVER DOMAINS</span>
            <span class="text-xs text-violet-400">&rarr;</span>
          </a>
          <a
            href="/chronicle"
            class="mobile-nav-link flex items-center justify-between py-2.5 border-b border-violet-500/10 text-slate-200 hover:text-pink-300 transition-colors"
          >
            <span>📰 THE CHRONICLE</span>
            <span class="text-xs text-pink-400">&rarr;</span>
          </a>
          <a
            href="/timeline"
            class="mobile-nav-link flex items-center justify-between py-2.5 border-b border-violet-500/10 text-slate-200 hover:text-amber-300 transition-colors"
          >
            <span>⏳ UNIVERSE TIMELINE</span>
            <span class="text-xs text-amber-400">&rarr;</span>
          </a>
          <a
            href="/glossary"
            class="mobile-nav-link flex items-center justify-between py-2.5 border-b border-violet-500/10 text-slate-200 hover:text-emerald-300 transition-colors"
          >
            <span>📖 SCIENTIFIC GLOSSARY</span>
            <span class="text-xs text-emerald-400">&rarr;</span>
          </a>
          <a
            href="/admin"
            class="mobile-nav-link flex items-center justify-between py-2.5 text-violet-400 hover:text-violet-300 font-semibold"
          >
            <span>🛠️ CONTROL ROOM (/admin)</span>
            <span class="text-xs">&rarr;</span>
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Page Content Slot -->
    <main class="flex-1 relative z-10">
      <slot />
    </main>

    <!-- Master Footer -->
    <footer class="relative z-10 border-t border-violet-500/15 bg-cosmic-950/90 pt-16 pb-12 mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
          <!-- Col 1: Brand & Philosophy -->
          <div class="md:col-span-2 space-y-4">
            <h3 class="site-name-text text-xl font-bold font-heading tracking-widest text-white">
              {siteConfig.siteName}
            </h3>
            <p class="site-tagline-text text-sm font-heading italic text-violet-300">
              "{siteConfig.tagline}"
            </p>
            <p class="text-xs text-slate-400 max-w-md leading-relaxed font-body">
              An advanced digital observatory and interactive scientific knowledge ecosystem dedicated to planetary science, astrophysics, relativistic cosmology, and the unanswered questions of existence.
            </p>
            <div class="pt-2 text-xs font-mono text-cyan-400">
              Platform Creator & Lead Architect: <span class="creator-name-text text-white font-semibold">{siteConfig.creatorName}</span>
            </div>
          </div>

          <!-- Col 2: Exploration Pathways -->
          <div>
            <h4 class="text-xs font-mono uppercase tracking-widest text-slate-300 mb-4 font-semibold">
              Exploration Pathways
            </h4>
            <ul class="space-y-2 text-xs font-mono text-slate-400">
              <li><a href="/explore/black-holes" class="hover:text-violet-300 transition-colors">Black Holes</a></li>
              <li><a href="/explore/the-big-bang" class="hover:text-violet-300 transition-colors">The Big Bang</a></li>
              <li><a href="/explore/neutron-stars" class="hover:text-violet-300 transition-colors">Neutron Stars</a></li>
              <li><a href="/explore/dark-matter" class="hover:text-violet-300 transition-colors">Dark Matter & Energy</a></li>
              <li><a href="/explore/james-webb-discoveries" class="hover:text-violet-300 transition-colors">James Webb Discoveries</a></li>
              <li><a href="/explore/the-milky-way" class="hover:text-violet-300 transition-colors">The Milky Way</a></li>
            </ul>
          </div>

          <!-- Col 3: Discovery Modules -->
          <div>
            <h4 class="text-xs font-mono uppercase tracking-widest text-slate-300 mb-4 font-semibold">
              Scientific Modules
            </h4>
            <ul class="space-y-2 text-xs font-mono text-slate-400">
              <li><a href="/#solar-system" class="hover:text-cyan-300 transition-colors">3D Solar System</a></li>
              <li><a href="/chronicle" class="hover:text-pink-300 transition-colors">The Cosmic Chronicle</a></li>
              <li><a href="/timeline" class="hover:text-stellar-amber transition-colors">Universe Timeline</a></li>
              <li><a href="/glossary" class="hover:text-emerald-300 transition-colors">Scientific Glossary</a></li>
              <li><a href="/admin" class="hover:text-violet-400 transition-colors">Control Room (/admin)</a></li>
            </ul>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="pt-8 border-t border-violet-500/10 flex flex-col sm:flex-row items-center justify-between text-[11px] font-mono text-slate-500 gap-4">
          <p>© {new Date().getFullYear()} The Cosmic Inquiry. Engineered by Albin Thomas.</p>
          <div class="flex items-center gap-6">
            <span class="flex items-center gap-1.5 text-cyan-400">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
              Netlify Production Edge
            </span>
            <span class="flex items-center gap-1.5 text-violet-400">
              <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
              GitHub Cloud Repository
            </span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Drawer Interaction Script -->
    <script is:inline>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const drawer = document.getElementById('mobile-menu-drawer');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (menuBtn && drawer) {
        menuBtn.addEventListener('click', () => {
          const isOpen = !drawer.classList.contains('hidden');
          if (isOpen) {
            drawer.classList.add('hidden');
            hamburgerIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
            menuBtn.setAttribute('aria-expanded', 'false');
          } else {
            drawer.classList.remove('hidden');
            hamburgerIcon.classList.add('hidden');
            closeIcon.classList.remove('hidden');
            menuBtn.setAttribute('aria-expanded', 'true');
          }
        });

        // Close on link click
        document.querySelectorAll('.mobile-nav-link').forEach((link) => {
          link.addEventListener('click', () => {
            drawer.classList.add('hidden');
            hamburgerIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
            menuBtn.setAttribute('aria-expanded', 'false');
          });
        });
      }

      // Live Reactive Website Configuration Synchronizer
      function applyLiveCosmicConfig() {
        try {
          const raw = localStorage.getItem('cosmic_inquiry_site_config');
          if (!raw) return;
          const cfg = JSON.parse(raw);
          if (cfg.siteName) {
            document.querySelectorAll('.site-name-text').forEach((el) => { el.textContent = cfg.siteName; });
          }
          if (cfg.tagline) {
            document.querySelectorAll('.site-tagline-text').forEach((el) => { el.textContent = `"${cfg.tagline}"`; });
          }
          if (cfg.creatorName) {
            document.querySelectorAll('.creator-name-text').forEach((el) => { el.textContent = cfg.creatorName; });
          }
          if (cfg.creatorSubtitle) {
            document.querySelectorAll('.creator-subtitle-text').forEach((el) => { el.textContent = cfg.creatorSubtitle; });
          }
          if (cfg.heroBadge) {
            document.querySelectorAll('.hero-badge-text').forEach((el) => { el.textContent = cfg.heroBadge; });
          }
          if (cfg.heroHeadingLine1) {
            document.querySelectorAll('.hero-heading-1').forEach((el) => { el.textContent = cfg.heroHeadingLine1; });
          }
          if (cfg.heroHeadingLine2) {
            document.querySelectorAll('.hero-heading-2').forEach((el) => { el.textContent = cfg.heroHeadingLine2; });
          }
          if (cfg.heroDescription) {
            document.querySelectorAll('.hero-desc-text').forEach((el) => { el.textContent = `"${cfg.heroDescription}"`; });
          }
          if (cfg.heroCtaPrimary) {
            document.querySelectorAll('.hero-cta-primary-text').forEach((el) => { el.textContent = cfg.heroCtaPrimary; });
          }
          if (cfg.heroCtaSecondary) {
            document.querySelectorAll('.hero-cta-secondary-text').forEach((el) => { el.textContent = cfg.heroCtaSecondary; });
          }
          if (cfg.solarSystemTitle) {
            document.querySelectorAll('.solar-system-title-text').forEach((el) => { el.textContent = cfg.solarSystemTitle; });
          }
          if (cfg.solarSystemDescription) {
            document.querySelectorAll('.solar-system-desc-text').forEach((el) => { el.textContent = cfg.solarSystemDescription; });
          }
          if (cfg.domainsTitle) {
            document.querySelectorAll('.domains-title-text').forEach((el) => { el.textContent = cfg.domainsTitle; });
          }
          if (cfg.domainsDescription) {
            document.querySelectorAll('.domains-desc-text').forEach((el) => { el.textContent = cfg.domainsDescription; });
          }
          if (cfg.chronicleTitle) {
            document.querySelectorAll('.chronicle-title-text').forEach((el) => { el.textContent = cfg.chronicleTitle; });
          }
          if (cfg.chronicleDescription) {
            document.querySelectorAll('.chronicle-desc-text').forEach((el) => { el.textContent = cfg.chronicleDescription; });
          }
        } catch (e) {
          console.warn('Live config sync error', e);
        }
      }

      applyLiveCosmicConfig();
      window.addEventListener('cosmic-config-updated', applyLiveCosmicConfig);
    </script>
  </body>
</html>
