---
import Layout from '../layouts/Layout.astro';
import { getTimelineEras, getSiteConfig } from '../lib/cosmic-service';
import { Clock, Sparkles, Orbit, Flame, CheckCircle, ArrowDown } from 'lucide-react';

const eras = getTimelineEras();
const config = getSiteConfig();
---

<Layout
  title={`${config.timelineTitle} | ${config.siteName}`}
  description={config.timelineDescription}
>
  <div class="min-h-screen pt-12 pb-24 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono uppercase tracking-widest text-stellar-gold bg-amber-950/40 border border-amber-500/30 mb-4">
        <Clock className="w-3.5 h-3.5" />
        <span>Universal Chronology</span>
      </div>
      <h1 class="timeline-title-text text-4xl sm:text-6xl font-black font-heading text-white tracking-tight">
        {config.timelineTitle}
      </h1>
      <p class="timeline-desc-text mt-4 text-base sm:text-lg text-slate-300 font-body leading-relaxed">
        {config.timelineDescription}
      </p>
    </div>

    <!-- Timeline Vertical Feed -->
    <div class="relative">
      <div class="hidden sm:block absolute left-8 top-6 bottom-6 w-[2px] bg-gradient-to-b from-cyan-400 via-violet-500 to-amber-500 opacity-40"></div>

      <div class="space-y-12">
        {eras.map((era, index) => (
          <div class="relative sm:pl-20">
            <!-- Node Pin -->
            <div class="hidden sm:flex absolute left-4 -translate-x-1/2 top-4 w-9 h-9 rounded-full bg-cosmic-950 border-2 border-violet-400 items-center justify-center shadow-[0_0_15px_rgba(139,92,246,0.6)] z-10 text-xs font-mono font-bold text-cyan-300">
              {String(index + 1).padStart(2, '0')}
            </div>

            <!-- Card -->
            <div class="p-6 sm:p-8 rounded-3xl bg-cosmic-900/80 border border-violet-500/20 hover:border-violet-500/50 backdrop-blur-md transition-all shadow-xl">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="text-xs font-mono text-cyan-400 font-semibold tracking-widest uppercase">
                  {era.era}
                </span>
                <span class="px-3 py-1 rounded-full bg-cosmic-950 border border-violet-500/20 text-xs font-mono text-stellar-gold">
                  {era.timeRange}
                </span>
              </div>

              <h2 class="text-2xl font-bold font-heading text-white mb-2">
                {era.title}
              </h2>

              {era.temperatureKelvin && (
                <div class="inline-block text-xs font-mono text-violet-300 mb-3 bg-violet-950/40 px-2.5 py-0.5 rounded border border-violet-500/20">
                  Thermal State: {era.temperatureKelvin}
                </div>
              )}

              <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-body mb-6">
                {era.description}
              </p>

              <!-- Key Milestones -->
              <div class="pt-4 border-t border-violet-500/15">
                <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block mb-2">
                  Key Epochal Milestones:
                </span>
                <ul class="space-y-1.5 text-xs font-mono text-slate-300">
                  {era.keyMilestones.map((m) => (
                    <li class="flex items-start gap-2">
                      <span class="text-cyan-400 font-bold">•</span>
                      <span>{m}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
