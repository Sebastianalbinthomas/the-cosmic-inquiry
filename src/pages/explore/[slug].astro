---
import Layout from '../../layouts/Layout.astro';
import { getTopicBySlug, getTopics, getCategories } from '../../lib/cosmic-service';
import { ArrowLeft, Share2, Clock, Calendar, User, BookOpen, ExternalLink, Sparkles, CheckCircle2 } from 'lucide-react';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/#discover');
}

const topic = await getTopicBySlug(slug);

if (!topic) {
  return Astro.redirect('/#discover');
}

const allTopics = await getTopics();
const relatedTopics = allTopics
  .filter((t) => t.id !== topic.id && (t.categoryId === topic.categoryId || true))
  .slice(0, 3);
---

<Layout
  title={`${topic.title} | The Cosmic Inquiry`}
  description={topic.excerpt}
  image={topic.coverImage}
  type="article"
>
  <article class="min-h-screen pt-8 pb-24 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- Breadcrumb & Back navigation -->
    <div class="mb-8 flex items-center justify-between text-xs font-mono text-slate-400">
      <a
        href="/#discover"
        class="inline-flex items-center gap-2 hover:text-white transition-colors py-1 px-3 rounded-full bg-cosmic-900 border border-violet-500/20"
      >
        <ArrowLeft className="w-3.5 h-3.5 text-cyan-400" />
        <span>BACK TO EXPLORATION</span>
      </a>

      <div class="flex items-center gap-2">
        <span class="px-3 py-1 rounded-full bg-violet-950/60 border border-violet-500/30 text-violet-300">
          {topic.categoryName || 'Astrophysics'}
        </span>
      </div>
    </div>

    <!-- Article Header -->
    <header class="space-y-6 mb-12">
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black font-heading tracking-tight text-white leading-tight">
        {topic.title}
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed font-body">
        {topic.excerpt}
      </p>

      <!-- Metadata Bar -->
      <div class="py-4 border-y border-violet-500/20 flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-slate-400">
        <div class="flex items-center gap-6">
          <span class="flex items-center gap-1.5 text-slate-300 font-semibold">
            <User className="w-4 h-4 text-cyan-400" />
            {topic.authorName}
          </span>
          <span class="flex items-center gap-1.5">
            <Calendar className="w-4 h-4 text-violet-400" />
            {new Date(topic.publishedAt).toLocaleDateString('en-US', {
              month: 'long',
              day: 'numeric',
              year: 'numeric'
            })}
          </span>
          <span class="flex items-center gap-1.5">
            <Clock className="w-4 h-4 text-stellar-gold" />
            {topic.readingTime}
          </span>
        </div>

        <!-- Share Trigger -->
        <button
          onclick="navigator.clipboard.writeText(window.location.href); alert('Copied article link to clipboard!');"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-cosmic-850 hover:bg-violet-900/40 border border-violet-500/20 text-slate-300 hover:text-white transition-all"
          title="Share Article Link"
        >
          <Share2 className="w-3.5 h-3.5 text-cyan-400" />
          <span>Share Article</span>
        </button>
      </div>
    </header>

    <!-- Cover Media Banner -->
    <div class="relative rounded-3xl overflow-hidden bg-cosmic-900 border border-violet-500/25 mb-14 shadow-2xl">
      <img
        src={topic.coverImage}
        alt={topic.title}
        class="w-full max-h-[550px] object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-cosmic-950 via-transparent to-transparent"></div>
    </div>

    <!-- Key Scientific Facts Grid Panel per Part 7 -->
    {topic.keyFacts && topic.keyFacts.length > 0 && (
      <div class="mb-14 p-6 sm:p-8 rounded-3xl bg-cosmic-900/80 border border-cyan-500/30 backdrop-blur-md shadow-xl">
        <div class="flex items-center gap-2 text-xs font-mono text-cyan-400 uppercase tracking-widest mb-4">
          <Sparkles className="w-4 h-4 text-cyan-400" />
          <span>Astrophysical Parameters & Key Constants</span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {topic.keyFacts.map((fact) => (
            <div class="p-4 rounded-2xl bg-cosmic-950/70 border border-cyan-500/15">
              <span class="text-[11px] font-mono text-slate-400 block mb-1">{fact.label}</span>
              <div class="text-xl sm:text-2xl font-bold font-heading text-white">
                {fact.value} <span class="text-xs font-mono text-cyan-300 font-normal">{fact.unit}</span>
              </div>
              {fact.description && (
                <span class="text-[10px] text-slate-500 font-body block mt-1">{fact.description}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Main Content Area -->
    <div class="prose prose-invert prose-violet max-w-none space-y-6 text-slate-200 leading-relaxed font-body text-base sm:text-lg">
      <div class="whitespace-pre-line leading-relaxed space-y-4">
        {topic.content}
      </div>
    </div>

    <!-- Embedded Video Player if present -->
    {topic.videoUrl && (
      <div class="my-14 rounded-3xl overflow-hidden border border-violet-500/30 bg-cosmic-950 shadow-2xl">
        <div class="p-4 border-b border-violet-500/20 text-xs font-mono text-violet-300 flex items-center justify-between">
          <span>SCIENTIFIC VISUALIZATION & DOCUMENTARY</span>
          <span class="text-cyan-400">High-Definition Simulation</span>
        </div>
        <div class="relative w-full aspect-video">
          <iframe
            src={topic.videoUrl}
            title={topic.title}
            class="absolute inset-0 w-full h-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    )}

    <!-- Scientific References & Sources per Part 7 -->
    {topic.referencesList && topic.referencesList.length > 0 && (
      <section class="mt-16 pt-10 border-t border-violet-500/20">
        <div class="flex items-center gap-2 text-xs font-mono text-violet-400 uppercase tracking-widest mb-6">
          <BookOpen className="w-4 h-4" />
          <span>Peer-Reviewed Citations & Institutional Sources</span>
        </div>
        <div class="space-y-3">
          {topic.referencesList.map((ref, idx) => (
            <div class="p-4 rounded-xl bg-cosmic-900/60 border border-violet-500/15 flex items-start justify-between gap-4 text-xs font-mono text-slate-300">
              <div>
                <span class="text-violet-400 font-semibold mr-2">[{idx + 1}]</span>
                <span class="text-white font-medium">{ref.title}</span> — <em>{ref.authors}</em> ({ref.journal}, {ref.year})
              </div>
              {ref.doiOrUrl && (
                <a
                  href={ref.doiOrUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-cyan-400 hover:text-cyan-300 flex items-center gap-1 flex-shrink-0"
                >
                  <span>DOI/Source</span>
                  <ExternalLink className="w-3.5 h-3.5" />
                </a>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Editorial Attribution -->
    <div class="mt-14 p-6 rounded-2xl bg-cosmic-900/40 border border-violet-500/15 flex items-center justify-between text-xs font-mono text-slate-400">
      <span>Curated & verified for The Cosmic Inquiry by <strong>{topic.authorName}</strong></span>
      <span>Published under Scientific Educational Open License</span>
    </div>

    <!-- Related Topics Navigation -->
    {relatedTopics.length > 0 && (
      <section class="mt-20 pt-12 border-t border-violet-500/20">
        <h3 class="text-xl font-bold font-heading text-white mb-6">
          Continue Your Cosmic Journey
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedTopics.map((rel) => (
            <a
              href={`/explore/${rel.slug}`}
              class="group p-5 rounded-2xl bg-cosmic-900/80 border border-violet-500/20 hover:border-violet-500/60 transition-all flex flex-col justify-between"
            >
              <div>
                <span class="text-[11px] font-mono text-cyan-400 block mb-1">{rel.categoryName}</span>
                <h4 class="text-base font-bold font-heading text-white group-hover:text-violet-300 transition-colors line-clamp-2">
                  {rel.title}
                </h4>
                <p class="mt-2 text-xs text-slate-400 line-clamp-2 font-body">{rel.excerpt}</p>
              </div>
              <div class="mt-4 pt-3 border-t border-violet-500/10 text-xs font-mono text-cyan-400 group-hover:translate-x-1 transition-transform">
                Read topic &rarr;
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
